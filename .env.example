# 复制为 .env 或直接在启动环境里设置即可（本项目为纯 Node/Express，无 Python 依赖）
# 服务监听端口
PORT=3000

# 运行环境：production 会启用 trust proxy 与 secure Cookie 默认策略
NODE_ENV=development

# Cookie 是否仅 HTTPS 传输：
#   HTTPS 域名部署 → true
#   HTTP + IP 直连 → false，否则无法登录
COOKIE_SECURE=false

# 会话签名密钥，生产环境务必替换（生成：openssl rand -hex 32）
SESSION_SECRET=change-me-please

# ---------- 后台管理 ----------
# 超级管理员账号（逗号分隔）。服务每次启动都会确保这些账号处于最高权限（role=admin、permissions=['*']）
# 超级管理员可进入「后台管理」，拥有全部管理功能与数据访问权，且不可被其他账号删除/降权
SUPER_ADMINS=452465968

# ---------- 系统级推送（Web Push，手机/桌面通知栏）----------
# 生成：node -e "const w=require('web-push');console.log(w.generateVAPIDKeys())"
# 注意：Web Push 只能在 HTTPS 安全上下文生效（HTTP + IP 部署时浏览器不会注册 Service Worker）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---------- 通知推送（QQ / 微信 / 邮件）----------
# 通知内容里的「查看详情」链接前缀（留空则不附链接）
APP_BASE_URL=http://<服务器IP或域名>

# 邮件（需要已安装 nodemailer：npm install nodemailer）
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# QQ：通过 QQ 机器人（OneBot v11 HTTP 插件，如 go-cqhttp / NapCat / Lagrange）私聊推送
# 接收地址填 QQ 号；要发到群则填 g:群号
QQ_ONEBOT_URL=http://127.0.0.1:5700
QQ_ONEBOT_TOKEN=

# 微信：wecom=企业微信群机器人；serverchan=Server酱（SendKey 填在个人设置的微信地址里）
WECHAT_MODE=wecom
WECHAT_WEBHOOK_URL=
WECHAT_PUSH_URL=

# 说明：
# 1) 依赖安装：npm install（Node.js >= 18）
# 2) 本地启动：npm start，然后访问 http://localhost:3000
# 3) 部署脚本见 deploy/deploy-aliyun.ps1（PowerShell，用 plink/pscp 上传并 pm2 重启）
# 4) pm2 配置：deploy/ecosystem.config.cjs；Nginx 反代参考：deploy/nginx.conf
# 5) 数据文件 data/db.json 为运行时生成（已 .gitignore），打包内附带一份便于直接运行
